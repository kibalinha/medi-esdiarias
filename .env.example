# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_STORAGE_BUCKET=field-photos

# Local fallback / dev mock mode (when Supabase env vars are absent or APP_DATA_MODE=local)
APP_DATA_MODE=local
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Groq Vision API (priorizado quando GROQ_API_KEY está configurado)
GROQ_API_KEY=your-groq-api-key
GROQ_OCR_MODEL=qwen/qwen3.8-27b

# Google Gemini Vision API (fallback opcional)
GEMINI_API_KEY=your-gemini-api-key
GEMINI_OCR_MODEL=gemini-2.5-flash

# Notifications (Resend Email + Web Push VAPID)
RESEND_API_KEY=re_your_resend_key
ALERT_EMAIL_FROM=alertas@medicoes.local
ALERT_EMAIL_TO=gestor@medicoes.local

NEXT_PUBLIC_VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
VAPID_SUBJECT=mailto:gestor@medicoes.local
